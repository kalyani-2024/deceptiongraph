# Copy to .env and adjust. Every one of these is optional: with none of them
# set, DeceptionGraph runs entirely in memory.

# Which network to load
DG_NETWORK=data/networks/enterprise.yaml
DG_STRATEGY=attack-path
DG_BUDGET=3
DG_MAX_DECOYS=12

# Graph store. Unset means the in-memory NetworkX repository.
# DG_NEO4J_URI=bolt://localhost:7687
# DG_NEO4J_USER=neo4j
# DG_NEO4J_PASSWORD=change-me

# Operational record. Unset means nothing is persisted.
# DG_DATABASE_URL=postgresql+psycopg://deception:deception@localhost:5432/deceptiongraph
# DG_SQL_ECHO=false

# Cache. Unset means a null cache.
# DG_REDIS_URL=redis://localhost:6379/0
# DG_REDIS_TTL=300
